# ─────────────────────────────────────────────────────────────
# Dime — tokenize your fomo.family profile on Pons.
# Copy to .env.local and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# --- Profile drafting (server-side only) ---
# Dime turns a fomo.family handle into a full profile-coin package.
# Provider: "bankr" (default) or "anthropic". Auto-detects from whichever
# key is set; force it with AI_PROVIDER. Without a key, drafting is disabled and
# users fill the fields by hand (the app still launches).
AI_PROVIDER=bankr

# Bankr LLM Gateway powers text + images with one key. Create a key with
# "LLM Gateway" enabled at https://bankr.bot/api-keys and top up credits.
BANKR_API_KEY=
BANKR_MODEL=claude-sonnet-5
# BANKR_IMAGE_MODEL=gpt-image-1          # Bankr image model for avatars
# BANKR_BASE_URL=https://llm.bankr.bot   # override only if needed

# Anthropic direct (optional text fallback only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Avatar images (profile avatars) ---
# Avatars are generated through the SAME Bankr key above (BANKR_IMAGE_MODEL). If
# Bankr isn't set you can point at any OpenAI-compatible images endpoint here;
# otherwise the avatar falls back to a deterministic SVG so the studio still runs.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024

# --- fomo.family profile detection (server-side only) ---
# Resolves a fomo.family handle to its real wallet + public profile (name,
# avatar, bio) via the FOMO API (https://fomoapi.io/docs). The resolved EVM
# wallet becomes the launch's creator-fee recipient, so a profile coin's fees
# route to that person's fomo.family wallet. Without a key, the "Detect
# fomo.family profile" step is disabled and fees fall back to the launcher.
# NOTE: the free tier meters handle→wallet resolution separately (25/month);
# results are cached in KV to protect that quota.
FOMO_API_KEY=
# FOMO_API_BASE_URL=https://api.fomoapi.io   # override only if needed

# --- Image storage (avatars + explore feed) ---
# Vercel KV (Storage tab) sets KV_REST_API_URL / KV_REST_API_TOKEN.
# An Upstash Redis integration sets the UPSTASH_* pair instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: a wallet allowed to remove any feed record (moderation).
ADMIN_ADDRESS=

# --- Wallet (mobile connect) ---
# WalletConnect Project ID (free at cloud.reown.com). Without it, MetaMask and
# injected/browser wallets still work; adding it enables WalletConnect QR.
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Chain / explorer (public, safe to expose) ---
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# --- Pons contract address (verified default hardcoded in registry.ts) ---
# Override only if needed.
NEXT_PUBLIC_PONS_V2_FACTORY=
# Optional: extra ERC-20 quote assets (RWA pairs), comma-separated. Validated
# on-chain before being shown. Native ETH is always available.
NEXT_PUBLIC_V2_PAIR_TOKENS=
